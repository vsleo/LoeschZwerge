{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && npx touch dist/.nojekyll && gh-pages -d dist ",
    "lint": "eslint . --fix && stylelint '**/*.{css,astro,vue}' --fix",
    "lint:style": "stylelint '**/*.{css,astro,vue}' --fix",
    "prettier": "prettier . --write ",
    "test": "playwright test",
    "check": "npm update && npm-check"
  },
  "dependencies": {
    "@astrojs/vue": "^5.1.0",
    "astro": "^5.10.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint-config-standard": "^38.0.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/css": "^0.9.0",
    "@playwright/test": "^1.53.2",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-vue": "^10.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "playwright": "^1.53.2",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.21.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "touch": "^3.1.1",
    "typescript-eslint": "^8.35.1"
  }
}
